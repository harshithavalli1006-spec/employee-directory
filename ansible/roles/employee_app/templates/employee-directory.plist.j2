<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.employee.directory</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/openjdk@17/bin/java</string>
        <string>-jar</string>
        <string>{{ ansible_user_dir }}/employee-directory-app/employee-directory.jar</string>
    </array>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{ ansible_user_dir }}/employee-directory-app/app.log</string>

    <key>StandardErrorPath</key>
    <string>{{ ansible_user_dir }}/employee-directory-app/app-error.log</string>
</dict>
</plist>
